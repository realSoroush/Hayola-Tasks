+                    }
+                  >
+                    <i style={{ width: `${(load / capacity) * 100}%` }} />
+                    <b
+                      style={{
+                        left: `${(p.weekly_capacity / capacity) * 100}%`,
+                      }}
+                    />
+                  </span>
+                  <span className="workload-value">
+                    <strong>{load}h</strong>
+                    <small>/ {p.weekly_capacity}h</small>
+                  </span>
+                </li>
